//MOC-FLAG --plugin ../../../../dist/icwire
import Wire "../../../../packages/fast/src/ICWire";
import Prim "mo:⛔";
func ok<T>(result : Wire.Result<T>) : T {
  switch result { case (#ok value) value; case (#err e) Prim.trap(debug_show e) }
};
assert ok(Wire.encode(null)) == "";
assert ok(Wire.encode(())) == "";
assert ok(Wire.encode(false)) == "\00";
assert ok(Wire.encode(true)) == "\01";
assert ok(Wire.encode(0 : Nat)) == "\00";
assert ok(Wire.encode(127 : Nat)) == "\7f";
assert ok(Wire.encode(128 : Nat)) == "\80\01";
assert ok(Wire.encode(-1 : Int)) == "\7f";
assert ok(Wire.encode(-64 : Int)) == "\40";
assert ok(Wire.encode(-65 : Int)) == "\bf\7f";
assert ok(Wire.encode(64 : Int)) == "\c0\00";
assert ok(Wire.encode(255 : Nat8)) == "\ff";
assert ok(Wire.encode(0x1234 : Nat16)) == "\34\12";
assert ok(Wire.encode(0x12345678 : Nat32)) == "\78\56\34\12";
assert ok(Wire.encode(0x0123456789abcdef : Nat64)) == "\ef\cd\ab\89\67\45\23\01";
assert ok(Wire.encode(-128 : Int8)) == "\80";
assert ok(Wire.encode(-32768 : Int16)) == "\00\80";
assert ok(Wire.encode(-2147483648 : Int32)) == "\00\00\00\80";
assert ok(Wire.encode(-9223372036854775808 : Int64)) == "\00\00\00\00\00\00\00\80";
assert ok(Wire.decode<Nat64>("\ff\ff\ff\ff\ff\ff\ff\ff")) == 18446744073709551615;
assert ok(Wire.decode<Int8>("\ff")) == -1;
assert ok(Wire.decode<Int16>("\ff\ff")) == -1;
assert ok(Wire.decode<Int32>("\ff\ff\ff\ff")) == -1;
assert ok(Wire.decode<Int64>("\ff\ff\ff\ff\ff\ff\ff\ff")) == -1;
assert ok(Wire.encode("a☃" : Text)) == "\04a\e2\98\83";
assert ok(Wire.encode("\00\ff" : Blob)) == "\02\00\ff";
assert ok(Wire.encode('😀')) == "\00\f6\01\00";
assert ok(Wire.decode<Char>("\00\f6\01\00")) == '😀';
let principal = Prim.principalOfBlob("\04");
assert ok(Wire.encode(principal)) == "\01\04";
assert ok(Wire.decode<Principal>("\01\04")) == principal;
assert ok(Wire.encode(1.5 : Float)) == "\00\00\00\00\00\00\f8\3f";
assert ok(Wire.encode(1.5 : Float32)) == "\00\00\c0\3f";
assert ok(Wire.encode(-0.0 : Float)) == "\00\00\00\00\00\00\00\80";
assert ok(Wire.encode(-0.0 : Float32)) == "\00\00\00\80";
assert ok(Wire.encode(ok(Wire.decode<Float>("\00\00\00\00\00\00\00\80")))) == "\00\00\00\00\00\00\00\80";
assert ok(Wire.encode(ok(Wire.decode<Float32>("\00\00\00\80")))) == "\00\00\00\80";
assert ok(Wire.encode((255 : Nat8, true, "x" : Text))) == "\ff\01\01x";
assert ok(Wire.encode([null, null, null] : [Null])) == "\03";
assert ok(Wire.decode<[Null]>("\03")) == [null, null, null];
assert ok(Wire.encode(null : ?Nat)) == "\00";
assert ok(Wire.encode(?127 : ?Nat)) == "\01\7f";
assert ok(Wire.encode(?null : ??Nat)) == "\01\00";
assert ok(Wire.decode<??Nat>("\01\00")) == ?null;
let ints : [Int] = [-99999999999999999999999999999999, -9223372036854775808, -129, -128, -65, -64, -1, 0, 1, 63, 64, 127, 128, 18446744073709551616, 99999999999999999999999999999999];
assert ok(Wire.decode<[Int]>(ok(Wire.encode(ints)))) == ints;
let nats : [Nat] = [0, 1, 127, 128, 16383, 16384, 18446744073709551615, 18446744073709551616, 99999999999999999999999999999999];
assert ok(Wire.decode<[Nat]>(ok(Wire.encode(nats)))) == nats;
// Exercise both sides of the compact managed-integer and nine-byte LEB paths.
let edgeNats : [Nat] = [4611686018427387903, 4611686018427387904, 9223372036854775807, 9223372036854775808];
assert ok(Wire.decode<[Nat]>(ok(Wire.encode(edgeNats)))) == edgeNats;
let edgeInts : [Int] = [-9223372036854775809, -9223372036854775808, -4611686018427387905, -4611686018427387904, -4611686018427387903, 4611686018427387903, 4611686018427387904, 9223372036854775807, 9223372036854775808];
assert ok(Wire.decode<[Int]>(ok(Wire.encode(edgeInts)))) == edgeInts;
assert ok(Wire.encode(4611686018427387903 : Int)) == "\ff\ff\ff\ff\ff\ff\ff\ff\3f";
assert ok(Wire.encode(-4611686018427387904 : Int)) == "\80\80\80\80\80\80\80\80\40";
assert ok(Wire.encode(9223372036854775807 : Nat)) == "\ff\ff\ff\ff\ff\ff\ff\ff\7f";
