//MOC-FLAG --plugin ../../../../dist/icwire
import Wire "../../../../packages/fast/src/ICWire";
import Prim "mo:⛔";
func ok<T>(result : Wire.Result<T>) : T {
  switch result { case (#ok value) value; case (#err e) Prim.trap(debug_show e) }
};
assert ok(Wire.encode(null)) == "ICW1";
assert ok(Wire.encode(())) == "ICW1";
assert ok(Wire.encode(false)) == "ICW1\00";
assert ok(Wire.encode(true)) == "ICW1\01";
assert ok(Wire.encode(0 : Nat)) == "ICW1\00";
assert ok(Wire.encode(127 : Nat)) == "ICW1\7f";
assert ok(Wire.encode(128 : Nat)) == "ICW1\80\01";
assert ok(Wire.encode(-1 : Int)) == "ICW1\7f";
assert ok(Wire.encode(-64 : Int)) == "ICW1\40";
assert ok(Wire.encode(-65 : Int)) == "ICW1\bf\7f";
assert ok(Wire.encode(64 : Int)) == "ICW1\c0\00";
assert ok(Wire.encode(255 : Nat8)) == "ICW1\ff";
assert ok(Wire.encode(0x1234 : Nat16)) == "ICW1\34\12";
assert ok(Wire.encode(0x12345678 : Nat32)) == "ICW1\78\56\34\12";
assert ok(Wire.encode(0x0123456789abcdef : Nat64)) == "ICW1\ef\cd\ab\89\67\45\23\01";
assert ok(Wire.encode(-128 : Int8)) == "ICW1\80";
assert ok(Wire.encode(-32768 : Int16)) == "ICW1\00\80";
assert ok(Wire.encode(-2147483648 : Int32)) == "ICW1\00\00\00\80";
assert ok(Wire.encode(-9223372036854775808 : Int64)) == "ICW1\00\00\00\00\00\00\00\80";
assert ok(Wire.decode<Nat64>("ICW1\ff\ff\ff\ff\ff\ff\ff\ff")) == 18446744073709551615;
assert ok(Wire.decode<Int8>("ICW1\ff")) == -1;
assert ok(Wire.decode<Int16>("ICW1\ff\ff")) == -1;
assert ok(Wire.decode<Int32>("ICW1\ff\ff\ff\ff")) == -1;
assert ok(Wire.decode<Int64>("ICW1\ff\ff\ff\ff\ff\ff\ff\ff")) == -1;
assert ok(Wire.encode("a☃" : Text)) == "ICW1\04\00\00\00a\e2\98\83";
assert ok(Wire.encode("\00\ff" : Blob)) == "ICW1\02\00\00\00\00\ff";
assert ok(Wire.encode('😀')) == "ICW1\00\f6\01\00";
assert ok(Wire.decode<Char>("ICW1\00\f6\01\00")) == '😀';
let principal = Prim.principalOfBlob("\04");
assert ok(Wire.encode(principal)) == "ICW1\01\00\00\00\04";
assert ok(Wire.decode<Principal>("ICW1\01\00\00\00\04")) == principal;
assert ok(Wire.encode(1.5 : Float)) == "ICW1\00\00\00\00\00\00\f8\3f";
assert ok(Wire.encode(1.5 : Float32)) == "ICW1\00\00\c0\3f";
assert ok(Wire.encode(-0.0 : Float)) == "ICW1\00\00\00\00\00\00\00\80";
assert ok(Wire.encode(-0.0 : Float32)) == "ICW1\00\00\00\80";
assert ok(Wire.encode(ok(Wire.decode<Float>("ICW1\00\00\00\00\00\00\00\80")))) == "ICW1\00\00\00\00\00\00\00\80";
assert ok(Wire.encode(ok(Wire.decode<Float32>("ICW1\00\00\00\80")))) == "ICW1\00\00\00\80";
assert ok(Wire.encode((255 : Nat8, true, "x" : Text))) == "ICW1\ff\01\01\00\00\00x";
assert ok(Wire.encode([null, null, null] : [Null])) == "ICW1\03\00\00\00";
assert ok(Wire.decode<[Null]>("ICW1\03\00\00\00")) == [null, null, null];
assert ok(Wire.encode(null : ?Nat)) == "ICW1\00";
assert ok(Wire.encode(?127 : ?Nat)) == "ICW1\01\7f";
assert ok(Wire.encode(?null : ??Nat)) == "ICW1\01\00";
assert ok(Wire.decode<??Nat>("ICW1\01\00")) == ?null;
let ints : [Int] = [-99999999999999999999999999999999, -9223372036854775808, -129, -128, -65, -64, -1, 0, 1, 63, 64, 127, 128, 18446744073709551616, 99999999999999999999999999999999];
assert ok(Wire.decode<[Int]>(ok(Wire.encode(ints)))) == ints;
let nats : [Nat] = [0, 1, 127, 128, 16383, 16384, 18446744073709551615, 18446744073709551616, 99999999999999999999999999999999];
assert ok(Wire.decode<[Nat]>(ok(Wire.encode(nats)))) == nats;
// Exercise both sides of the compact managed-integer and nine-byte LEB paths.
let edgeNats : [Nat] = [4611686018427387903, 4611686018427387904, 9223372036854775807, 9223372036854775808];
assert ok(Wire.decode<[Nat]>(ok(Wire.encode(edgeNats)))) == edgeNats;
let edgeInts : [Int] = [-9223372036854775809, -9223372036854775808, -4611686018427387905, -4611686018427387904, -4611686018427387903, 4611686018427387903, 4611686018427387904, 9223372036854775807, 9223372036854775808];
assert ok(Wire.decode<[Int]>(ok(Wire.encode(edgeInts)))) == edgeInts;
assert ok(Wire.encode(4611686018427387903 : Int)) == "ICW1\ff\ff\ff\ff\ff\ff\ff\ff\3f";
assert ok(Wire.encode(-4611686018427387904 : Int)) == "ICW1\80\80\80\80\80\80\80\80\40";
assert ok(Wire.encode(9223372036854775807 : Nat)) == "ICW1\ff\ff\ff\ff\ff\ff\ff\ff\7f";
