  func choice(i : Nat) : Choice {
    switch (i / 256) {
      case 0 choice_0(i);
      case 1 choice_1(i);
      case 2 choice_2(i);
      case 3 choice_3(i);
      case 4 choice_4(i);
      case 5 choice_5(i);
      case 6 choice_6(i);
      case 7 choice_7(i);
      case 8 choice_8(i);
      case 9 choice_9(i);
      case 10 choice_10(i);
      case 11 choice_11(i);
      case 12 choice_12(i);
      case 13 choice_13(i);
      case 14 choice_14(i);
      case 15 choice_15(i);
      case 16 choice_16(i);
      case 17 choice_17(i);
      case 18 choice_18(i);
      case 19 choice_19(i);
      case 20 choice_20(i);
      case 21 choice_21(i);
      case 22 choice_22(i);
      case 23 choice_23(i);
      case 24 choice_24(i);
      case 25 choice_25(i);
      case 26 choice_26(i);
      case 27 choice_27(i);
      case 28 choice_28(i);
      case 29 choice_29(i);
