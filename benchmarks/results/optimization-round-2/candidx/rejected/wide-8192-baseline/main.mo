  public func configure(index : Nat) : async () {
    bytes := ""; numbers := []; records := []; nested := []; variants := []; output := "";
    switch index {
      case 0 {  };
case 1 { bytes := makeBlob(0); };
case 2 { bytes := makeBlob(32); };
case 3 { bytes := makeBlob(55); };
case 4 { bytes := makeBlob(56); };
case 5 { bytes := makeBlob(64); };
case 6 { bytes := makeBlob(1024); };
case 7 { bytes := makeBlob(65536); };
case 8 { bytes := makeBlob(1048576); };
case 9 {  };
case 10 { scalar := 42; };
case 11 {  };
case 12 { bytes := makeBlob(65536); };
case 13 { numbers := Prim.Array_tabulate<Nat64>(4096, func(i) { Prim.natToNat64(i * 17) }); };
case 14 { 
      let memo = makeBlob(32);
      records := Prim.Array_tabulate<Sparse>(128, func(i) {
        { id = i; tag = if (i % 4 == 0) ?"tag" else null;
           memo = if (i % 3 == 0) ?memo else null; absent = null;
           nested = { flag = i % 2 == 0; unused = null } }
      });
     };
case 15 { 
      let memo = makeBlob(32);
      records := Prim.Array_tabulate<Sparse>(1024, func(i) {
        { id = i; tag = if (i % 4 == 0) ?"tag" else null;
           memo = if (i % 3 == 0) ?memo else null; absent = null;
           nested = { flag = i % 2 == 0; unused = null } }
      });
     };
case 16 { 
      nested := Prim.Array_tabulate<?[?Nat]>(64, func(i) {
        if (i % 3 == 0) null else ?Prim.Array_tabulate<?Nat>(16, func(j) {
          if (j % 2 == 0) null else ?(i * 16 + j)
        })
      });
     };
case 17 { variants := Prim.Array_tabulate<Choice>(0, func(i) { choice(8191); }); };
case 18 { variants := Prim.Array_tabulate<Choice>(1, func(i) { choice(8191); }); };
case 19 { variants := Prim.Array_tabulate<Choice>(2, func(i) { choice(8191); }); };
case 20 { variants := Prim.Array_tabulate<Choice>(2, func(i) { choice(if (i == 0) 0 else 8191); }); };
case 21 { variants := Prim.Array_tabulate<Choice>(65, func(i) { choice(i * 127); }); };
      case _ Prim.trap("unknown benchmark")
    }
  };
  public func clear() : async () { output := "" };
  public query func bytesResult() : async Blob { output };
  
  public func bench_0() : async Measurement {
    let allocatedBefore = Prim.rts_total_allocation();
    let reclaimedBefore = Prim.rts_reclaimed();
    let started = Prim.performanceCounter(0);
    output := "";
    let ended = Prim.performanceCounter(0);
    let allocatedAfter = Prim.rts_total_allocation();
    let reclaimedAfter = Prim.rts_reclaimed();
    { instructions = ended - started;
       allocated = allocatedAfter - allocatedBefore;
       reclaimed = reclaimedAfter - reclaimedBefore;
       outputSize = output.size() }
  };


