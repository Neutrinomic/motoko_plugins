//MOC-FLAG --plugin ../../../../dist/queue --package fast ../../src --package core $MOTOKO_CORE
import Q "mo:fast/Queue";
import Nat "mo:core/Nat";
let q = Q.empty<Nat>();
assert q.isEmpty();
var i = 0;
while (i < 100) { q.pushBack(i); i += 1 };
q.assertValid();
assert q.size() == 100;
i := 0;
while (i < 70) { assert q.popFront() == ?i; i += 1 };
i := 100;
while (i < 180) { q.pushBack(i); i += 1 };
q.assertValid();
i := 180;
while (i > 70) { i -= 1; assert q.popBack() == ?i };
assert q.popBack() == null;
q.assertValid();
i := 0;
while (i < 100) { q.pushFront(i); i += 1 };
i := 100;
while (i > 0) { i -= 1; assert q.popFront() == ?i };
q.assertValid();
let nested = Q.empty<?Null>();
nested.pushBack(null);
nested.pushFront(?null);
assert nested.popFront() == ??null;
assert nested.popBack() == ?null;
assert nested.popFront() == null;
let copy = Q.fromArray<Nat>([1, 2, 3]);
assert copy.toArray() == [1, 2, 3];
assert copy.toText(Nat.toText) == "Queue[1, 2, 3]";
assert copy.equal(copy.clone(), Nat.equal);
assert copy.reverseValues().next() == ?3;
