import Prim "mo:⛔";
import BLAKE3 "mo:fast/BLAKE3";

func pattern(size : Nat) : Blob {
  Prim.arrayToBlob(Prim.Array_tabulate<Nat8>(size, func(i) { Prim.natToNat8(i % 251) }))
};
func segment(start : Nat, size : Nat) : Blob {
  Prim.arrayToBlob(Prim.Array_tabulate<Nat8>(size, func(i) { Prim.natToNat8((start + i) % 251) }))
};
func slice(input : Blob, start : Nat, size : Nat) : Blob {
  let bytes = Prim.blobToArray(input);
  Prim.arrayToBlob(Prim.Array_tabulate<Nat8>(size, func(i) { bytes[start + i] }))
};
func must(result : BLAKE3.Result<Blob>) : Blob {
  switch result { case (#ok(value)) value; case (#err(_)) { assert false; "" } }
};
