  (8193, "\ba\b6\c0\9c\b8\ce\8c\f4\59\26\13\98\d2\e7\ae\f3\57\00\bf\48\81\16\ce\b9\4a\36\d0\f5\f1\b7\bc\3b\b2\28\2a\a6\9b\e0\89\35\9e\a1\15\4b\9a\92\86\c4\a5\6a\f4\de\97\5a\9a\a4\a5\c4\97\65\49\14\d2\79\be\a6\0b\b6\d2\cf\72\25\a2\fa\0f\f5\ef\56\bb\e4\b1\49\f3\ed\15\86\0f\78\b4\e2\ad\04\e1\58\e3\75\c1\e0\c0\b5\51\cd\7d\fc\82\f1\b1\55\c1\1b\6b\3e\d5\1e\c9\ed\b3\0d\13\36\53\bb\57\09\d1\db\d5\5f\4e\1f\f6", "\95\4a\2a\75\42\0c\8d\65\47\e3\ba\5b\98\d9\63\e6\fa\64\91\ad\dc\8c\02\31\89\cc\51\98\21\b4\a1\f5\f0\32\28\64\8f\d9\83\ae\f0\45\c2\fa\82\90\93\4b\08\66\b6\15\f5\85\14\95\87\dd\a2\29\90\39\96\53\28\83\5a\2b\18\f1\d6\3b\7e\30\0f\c7\6f\f2\60\b5\71\83\9f\e4\48\76\a4\ea\e6\6c\ba\c8\c6\76\94\41\1e\d7\e0\9d\f5\10\68\a2\2c\6e\67\d6\d3\dd\2c\ca\8f\f1\2e\32\75\38\40\06\c8\0f\4d\b6\80\23\f2\4e\eb\ba\57", "\af\1e\03\46\e3\89\b1\7c\23\20\02\70\a6\4a\a4\e1\ea\d9\8c\61\69\5d\91\7d\e7\d5\b0\04\91\c9\b0\f1\2f\20\a0\1d\6d\62\2e\df\3d\e0\26\a4\db\4e\45\26\22\5d\eb\b9\3c\12\37\93\4d\71\c7\34\0b\b5\91\61\58\cb\da\fe\9a\c3\22\54\76\b6\ab\57\a1\23\57\db\3a\bb\ad\7a\26\c6\e6\62\90\e4\40\34\fb\08\a2\0a\8d\0e\c2\64\f3\09\99\4d\28\10\c4\9c\fb\a6\98\9d\7a\bb\09\58\97\45\9f\54\25\ad\b4\8a\ba\07\c5\fb\3c\83\c0"),
  (16384, "\f8\75\d6\64\6d\e2\89\85\64\6f\34\ee\13\be\9a\57\6f\d5\15\f7\6b\5b\0a\26\bb\32\47\35\04\1d\dd\e4\9d\76\4c\27\01\76\e5\3e\97\bd\ff\a5\8d\54\90\73\f2\c6\60\be\0e\81\29\37\67\ed\4e\49\29\f9\ad\34\bb\b3\9a\52\93\34\c5\7c\4a\38\1f\fd\2a\6d\4b\fd\bf\14\82\65\1b\17\2a\a8\83\cc\13\40\8f\a6\77\58\a3\e4\75\03\f9\3f\87\72\0a\31\77\32\5f\78\23\25\1b\85\27\5f\64\63\6a\8f\1d\59\9c\2e\49\72\2f\42\e9\38\93", "\9e\9f\c4\eb\7c\f0\81\ea\7c\47\d1\80\77\90\ed\21\1b\fe\c5\6a\a2\5b\b7\03\77\84\c1\3c\4b\70\7b\0d\f9\e6\01\b1\01\e4\cf\63\a4\04\df\e5\0f\2e\18\65\bb\12\ed\c8\fc\a1\66\57\9c\e0\c7\0d\ba\5a\5c\0f\c9\60\ad\6f\37\72\18\34\16\a0\0b\d2\9d\4c\6e\65\1e\a7\62\0b\b1\00\c9\44\98\58\bf\14\e1\dd\c9\ec\d3\57\25\58\1c\a5\b9\16\0d\e0\40\60\04\59\93\d9\72\57\1c\3e\8f\71\e9\d0\49\6b\fa\74\46\56\86\1b\16\9d\65", "\16\0e\18\b5\87\8c\d0\df\1c\3a\f8\5e\b2\5a\0d\b5\34\4d\43\a6\fb\d7\a8\ef\4e\d9\8d\07\14\c3\f7\e1\60\dc\0b\1f\09\ca\a3\5f\2f\41\7b\9e\f3\09\df\e5\eb\d6\7f\4c\95\07\99\5a\53\13\74\d0\99\cf\8a\e3\17\54\2e\88\5e\c6\f5\89\37\88\64\d3\ea\98\71\6b\3b\bb\65\ef\4a\b5\e0\ab\5b\b2\98\a5\01\f1\9a\41\ec\19\af\84\a5\e6\b4\28\ec\d8\13\b1\a4\7e\d9\1c\96\57\c3\fb\a1\1c\40\6b\c3\16\76\8b\58\f6\80\2c\9e\9b\57"),
  (31744, "\62\b6\96\0e\1a\44\bc\c1\eb\1a\61\1a\8d\62\35\b6\b4\b7\8f\32\e7\ab\c4\fb\4c\6c\dc\ce\94\89\5c\47\86\0c\c5\1f\2b\0c\28\a7\b7\73\04\bd\55\fe\73\af\66\3c\02\d3\f5\2e\a0\53\ba\43\43\1c\a5\ba\b7\bf\ea\2f\5e\9d\71\21\77\0d\88\f7\0a\e9\64\9e\a7\13\08\7d\19\14\f7\f3\12\14\7e\24\7f\87\eb\2d\4f\fe\f0\ac\97\8b\f7\b6\57\9d\57\d5\33\35\5a\a2\0b\8b\77\b1\3f\d0\97\48\72\8a\5c\c3\27\a8\ec\47\0f\40\13\22\6f", "\ef\a5\3b\38\9a\b6\7c\59\3d\ba\62\4d\89\8d\0f\73\53\ab\99\e4\ac\9d\42\30\2e\e6\4c\bf\99\39\a4\19\3a\72\58\db\2d\9c\d3\2a\7a\3e\cf\ce\46\14\41\14\b1\5c\2f\cb\68\a6\18\a9\76\bd\74\51\5d\47\be\08\b6\28\be\42\0b\5e\83\0f\ad\e7\c0\80\e3\51\a0\76\fb\c3\86\41\ad\80\c7\36\c8\a1\8f\e3\c6\6c\e1\2f\95\c6\1c\24\62\a9\77\0d\60\d0\f7\71\15\bb\cd\37\82\b5\93\01\6a\4e\72\8d\4c\06\ce\e4\50\5c\b0\c0\8a\42\ec", "\39\77\2a\ef\80\e0\eb\e6\05\96\36\1e\45\b0\61\e8\f4\17\42\9d\52\91\71\b6\76\44\68\c2\29\28\e2\8e\97\59\ad\eb\79\7a\3f\bf\77\1b\1b\ce\a3\01\50\a0\20\e3\17\98\2b\f0\d6\e7\d1\4d\d9\f0\64\bc\11\02\5c\25\f3\1e\81\bd\78\a9\21\db\01\74\f0\3d\d4\81\d3\0e\93\fd\8e\90\f8\b2\fe\e2\09\f8\49\f2\d2\a5\2f\31\71\9a\49\0f\b0\ba\7a\ea\1e\09\81\4e\e9\12\eb\a1\11\a9\fd\e9\d5\c2\74\18\5f\7b\ae\8b\a8\5d\30\0a\2b"),
  (102400, "\bc\3e\3d\41\a1\14\6b\06\9a\bf\fa\d3\c0\d4\48\60\cf\66\43\90\af\ce\4d\96\61\f7\90\2e\79\43\e0\85\e0\1c\59\da\b9\08\c0\4c\33\42\b8\16\94\1a\26\d6\9c\26\05\eb\ee\5e\c5\29\1c\c5\5e\15\b7\61\46\e6\74\5f\06\01\15\6c\35\96\cb\75\06\5a\9c\57\f3\55\85\a5\2e\1a\c7\0f\69\13\1c\23\d6\11\ce\11\ee\4a\b1\ec\2c\00\90\12\d2\36\64\8e\77\be\92\95\dd\04\26\f2\9b\76\4d\65\de\58\eb\7d\01\dd\42\24\82\04\f4\5f\8e", "\1c\35\d1\a5\81\10\83\fd\71\19\f5\d5\d1\ba\02\7b\4d\01\c0\c6\c4\9f\b6\ff\2c\f7\53\93\ea\5d\b4\a7\f9\db\dd\3e\1d\81\dc\bc\a3\ba\24\1b\b1\87\60\f2\07\71\0b\75\18\46\fa\ae\b9\df\f8\26\27\10\99\9a\59\b2\aa\1a\ca\29\8a\03\2d\94\ea\cf\ad\f1\aa\19\24\18\eb\54\80\8d\b2\3b\56\e3\42\13\26\6a\a0\84\99\a1\6b\35\4f\01\8f\c4\96\7d\05\f8\b9\d2\ad\87\a7\27\83\37\be\96\93\fc\63\8a\3b\fd\be\31\45\74\ee\6f\c4", "\46\52\cf\f7\a3\f3\85\a6\10\3b\5c\26\0f\c1\59\3e\13\c7\78\db\e6\08\ef\b0\92\fe\7e\e6\9d\f6\e9\c6\d8\3a\3e\04\1b\c3\a4\8d\f2\87\9f\4a\0a\3e\d4\0e\7c\96\1c\73\ef\f7\40\f3\11\7a\05\04\c2\df\f4\78\6d\44\fb\17\f1\54\9e\b0\ba\58\5e\40\ec\29\bf\77\32\f0\b7\e2\86\ff\8a\cd\dc\4c\b1\e2\3b\87\ff\5d\82\4a\98\64\58\dc\c6\a0\4a\c8\39\69\b8\06\37\56\29\53\df\51\ed\1a\7e\90\a7\92\69\24\d2\76\37\78\be\85\60"),
];
for ((size, hash, keyed, derived) in vectors.values()) {
  let input = pattern(size);
  assert BLAKE3.digest(input) == slice(hash, 0, 32);
  assert must(BLAKE3.keyedHash(key, input)) == slice(keyed, 0, 32);
  assert BLAKE3.deriveKey(context, input) == slice(derived, 0, 32);
  assert must(BLAKE3.xof(input, 0, 131)) == hash;
  assert must(BLAKE3.xof(input, 63, 65)) == slice(hash, 63, 65);
  let modes = [(BLAKE3.new(), hash), (must(BLAKE3.newKeyed(key)), keyed), (BLAKE3.newDeriveKey(context), derived)];
  for ((initial, expected) in modes.values()) {
    var state = initial;
    var offset = 0;
    while (offset < size) {
      let remaining = Prim.abs((size : Int) - offset);
      let take = if (remaining < 137) remaining else 137;
      state := must(BLAKE3.update(state, segment(offset, take)));
      offset += take;
    };
    assert must(BLAKE3.finalize(state)) == slice(expected, 0, 32);
    assert must(BLAKE3.finalizeXof(state, 0, 131)) == expected;
    assert must(BLAKE3.finalizeXof(state, 63, 65)) == slice(expected, 63, 65);
    assert state == must(BLAKE3.update(state, ""));
  };
  assert input == pattern(size);
};
