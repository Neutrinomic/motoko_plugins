for ((input, expected512, expected384) in vectors.values()) {
  let original = input;
  assert SHA512.digest(input) == expected512;
  assert SHA512.digest384(input) == expected384;
  let stream = SHA512.Digest();
  let stream384 = SHA512.Digest384();
  for (byte in input.values()) {
    let part = Prim.arrayToBlob([byte]);
    stream.write(part); stream384.write(part);
  };
  let saved = stream.sum();
  assert saved == expected512;
  assert stream.sum() == expected512;
  assert stream384.sum() == expected384;
  stream.write(""); stream384.write("");
  assert stream.sum() == saved;
  assert stream384.sum() == expected384;
  assert input == original;
  stream.reset(); stream384.reset();
  assert stream.sum() == SHA512.digest("");
  assert stream384.sum() == SHA512.digest384("");
};
let stream = SHA512.Digest();
stream.write("a"); let prefix = stream.sum();
assert prefix == SHA512.digest("a");
stream.write("bc");
assert stream.sum() == SHA512.digest("abc");
assert prefix == SHA512.digest("a");
func hash(bytes : Blob) : Blob { SHA512.digest(bytes) };
let callbacks : [Blob -> Blob] = [hash];
assert callbacks[0]("abc") == stream.sum();
// Invalid raw internal states are data failures, not interpreter failures.
assert Prim.sha512_update("", "abc") == null;
assert Prim.sha512_sum("bad") == null;
assert Prim.sha512_sum384(Prim.sha512_init()) == null;
assert Prim.sha512_sum(Prim.sha512_init384()) == null;
