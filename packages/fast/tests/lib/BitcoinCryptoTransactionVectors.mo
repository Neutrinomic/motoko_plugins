    ];
    for ((context, raw, stripped, txid, wtxid) in signedTransactions.values()) {
      let tx = parse(raw, context);
      check(Transaction.serialize(tx, true), raw, context # ": witness serialization");
      check(Transaction.serialize(tx, false), stripped, context # ": stripped serialization");
      check(Transaction.txid(tx), txid, context # ": txid display order");
      check(Transaction.wtxid(tx), wtxid, context # ": wtxid display order");
      let strippedTx = parse(stripped, context # " stripped");
      check(Transaction.txid(strippedTx), txid, context # ": txid ignores witness");
      check(Transaction.wtxid(strippedTx), txid, context # ": no-witness wtxid equals txid");
    };

