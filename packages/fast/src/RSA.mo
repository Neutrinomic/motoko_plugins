/// RSA-PSS signatures. Requires only the `rsa` plugin.
/// Fixed profile: RSA-3072, public exponent 65537, SHA-256, MGF1-SHA256,
/// exactly 32 bytes of salt. Public keys and signatures are 384-byte big-endian
/// integers; keys use an odd modulus with its most significant bit set.
/// Private keys are p || q || dP || dQ || qInv, each 192-byte big-endian,
/// totaling 960 bytes. This module does not parse DER or PEM.
import Prim "mo:⛔";

module {
  public type Error = {
    #invalidSecretKey;
    #invalidPublicKey;
    #invalidDigest;
    #invalidSalt;
    #invalidSignature;
  };
  public type Result<T> = { #ok : T; #err : Error };

  /// Derive the public modulus after validating the private CRT components.
  public let publicKey = Prim.rsa_public_key;

  /// Alias for publicKey, matching the key-derivation name of other modules.
  public let derivePublicKey = Prim.rsa_public_key;

  /// Check lengths, ranges and algebraic CRT consistency. Returns #ok(true)
  /// or #err(#invalidSecretKey). Does not prove p and q prime: import a key
  /// generated by a trusted RSA implementation. Signing checks its result
  /// against the public exponent before returning the signature.
  public let validatePrivateKey = Prim.rsa_validate_private_key;

  /// Validate the fixed-width, 3072-bit odd modulus encoding. Returns #ok(true)
  /// or #err(#invalidPublicKey). Does not certify the origin or strength of a key.
  public let validatePublicKey = Prim.rsa_validate_public_key;

  /// Hash a message with SHA-256 and sign with exactly 32 bytes of salt.
  /// Supply fresh salt from a cryptographically secure random source.
  /// Validation order is private key, then salt. No randomness is generated
  /// inside the plugin. Returns a 384-byte signature.
  public let sign = Prim.rsa_sign;

  /// Sign an exactly 32-byte SHA-256 message digest using a 32-byte salt.
  /// Validation order is private key, digest, then salt. The caller supplies
  /// fresh cryptographically secure salt, as for sign.
  public let signPrehash = Prim.rsa_sign_prehash;

  /// Hash a message with SHA-256 and verify its 384-byte PSS signature.
  /// Validation order is public key, then signature. Malformed signature
  /// length or an integer >= the modulus returns #err(#invalidSignature).
  /// Incorrect padding, salt length or message returns #ok(false).
  public let verify = Prim.rsa_verify;

  /// Verify against an exactly 32-byte SHA-256 message digest.
  /// Validation order is public key, digest, then signature.
  /// Signature error and mismatch semantics are identical to verify.
  public let verifyPrehash = Prim.rsa_verify_prehash;
}
