//MOC-FLAG --plugin ../../../../dist/mutable-map --package fast ../../../../packages/fast/src --package core $MOTOKO_CORE
//MOC-FLAG -A M0236
import Prim "mo:⛔";
import Map "mo:fast/Map";
// All supported scalar layouts exercise all native operations, including
// boxed 64-bit extrema, large integers, UTF-8, byte ordering, and null values.
do {
  type Key = Nat;
  let low : Key = 0;
  let high : Key = 184467440737095516160;
  let self = Map.empty<Key, ?Nat>();
  assert Prim.mmap_insert_static<Key, ?Nat>(self, high, null);
  Prim.mmap_add_static<Key, ?Nat>(self, low, ?1);
  assert Prim.mmap_contains_static<Key, ?Nat>(self, high);
  assert Prim.mmap_get_static<Key, ?Nat>(self, high) == ?null;
  assert Prim.mmap_get_entry_static<Key, ?Nat>(self, low) == ?(low, ?1);
  assert Prim.mmap_swap_static<Key, ?Nat>(self, high, ?2) == ?null;
  assert Prim.mmap_replace_static<Key, ?Nat>(self, high, ?3) == ??2;
  assert Map.entries(self).next() == ?(low, ?1);
  assert Map.reverseEntries(self).next() == ?(high, ?3);
  assert Prim.mmap_take_static<Key, ?Nat>(self, low) == ??1;
  assert not Prim.mmap_delete_static<Key, ?Nat>(self, low);
  assert Prim.mmap_replace_static<Key, ?Nat>(self, low, ?4) == null;
  Prim.mmap_remove_static<Key, ?Nat>(self, high);
  assert Map.isEmpty(self);
};
