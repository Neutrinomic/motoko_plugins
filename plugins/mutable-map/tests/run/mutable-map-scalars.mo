  assert Prim.mmap_swap_static<Key, ?Nat>(self, high, ?2) == ?null;
  assert Prim.mmap_replace_static<Key, ?Nat>(self, high, ?3) == ??2;
  assert Map.entries(self).next() == ?(low, ?1);
  assert Map.reverseEntries(self).next() == ?(high, ?3);
  assert Prim.mmap_take_static<Key, ?Nat>(self, low) == ??1;
  assert not Prim.mmap_delete_static<Key, ?Nat>(self, low);
  assert Prim.mmap_replace_static<Key, ?Nat>(self, low, ?4) == null;
  Prim.mmap_remove_static<Key, ?Nat>(self, high);
  assert Map.isEmpty(self);
};
