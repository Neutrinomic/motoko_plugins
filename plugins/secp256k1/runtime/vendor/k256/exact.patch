+fn odd_multiples(point: &ProjectivePoint) -> [ProjectivePoint; 8] {
+    let mut table = [*point; 8];
+    let double = point.double();
+    for i in 1..8 { table[i] = table[i - 1] + double; }
+    table
+}
+
+fn odd_table(point: &ProjectivePoint) -> [ProjectivePoint; 16] {
+    let mut table = [ProjectivePoint::IDENTITY; 16];
+    for (i, odd) in odd_multiples(point).into_iter().enumerate() {
+        table[i] = odd;
+        table[i + 8] = odd.endomorphism();
+    }
+    table
+}
+
+fn decode_affine(bytes: &[u8]) -> AffinePoint {
+    AffinePoint::new(
+        FieldElement::from_bytes_unchecked(bytes[..32].try_into().unwrap()),
+        FieldElement::from_bytes_unchecked(bytes[32..64].try_into().unwrap()))
+}
