+impl ProjectivePoint {
+    /// Serialize a validated nonidentity public point as eight odd multiples,
+    /// each canonical X || Y. Output must be 512 bytes. This pointer-free format
+    /// is private to factory-created prepared handles, never a Rust layout.
+    pub fn prepare_verification_key(point: &AffinePoint, output: &mut [u8]) {
+        assert_eq!(output.len(), 512);
+        let projective = odd_multiples(&Self::from(*point));
+        let affine = <Self as BatchNormalize<[Self; 8]>>::batch_normalize(&projective);
+        for (point, bytes) in affine.iter().zip(output.chunks_exact_mut(64)) {
+            bytes[..32].copy_from_slice(&point.x.to_bytes());
+            bytes[32..].copy_from_slice(&point.y.to_bytes());
+        }
+    }
+
+    /// Compute k*G+l*Q for public verification using a shared immutable G table.
+    /// Never use variable-time methods with secret scalars or points.
+    pub fn lincomb_generator_vartime(k: &Scalar, q: &Self, l: &Scalar) -> Self {
+        let digits = digits(k, l);
+        let table = odd_table(q);
+        let mut acc = Self::IDENTITY;
+        for bit in (0..129).rev() {
+            acc = acc.double();
+            for term in 0..4 {
+                let digit = digits[term][bit];
+                if digit == 0 { continue; }
+                let index = (term % 2) * 8 + (digit.unsigned_abs() as usize - 1) / 2;
+                if term < 2 {
+                    let point = GENERATOR[index];
+                    acc += if digit < 0 { -point } else { point };
+                } else {
+                    let point = table[index];
+                    acc += if digit < 0 { -point } else { point };
+                }
+            }
+        }
+        acc
+    }
+
+    /// Compute k*G+l*Q from an immutable factory-created verification cache.
+    /// Coordinates/table relations are trusted, not revalidated. Only use with
+    /// the matching cache factory and public scalars. No secret data is allowed.
+    pub fn lincomb_generator_prepared_vartime(k: &Scalar, prepared: &[u8], l: &Scalar) -> Self {
+        assert_eq!(prepared.len(), 512);
+        let digits = digits(k, l);
+        let mut table = [AffinePoint::IDENTITY; 16];
+        for (i, bytes) in prepared.chunks_exact(64).enumerate() {
+            let point = decode_affine(bytes);
+            table[i] = point;
+            // The same public endomorphism as ProjectivePoint::endomorphism:
+            // beta * X, Y. Deriving it saves 512 retained bytes per key.
+            table[i + 8] = AffinePoint::new(point.x * &ENDOMORPHISM_BETA, point.y);
+        }
+        let mut acc = Self::IDENTITY;
+        for bit in (0..129).rev() {
+            acc = acc.double();
+            for term in 0..4 {
+                let digit = digits[term][bit];
+                if digit == 0 { continue; }
+                let index = (term % 2) * 8 + (digit.unsigned_abs() as usize - 1) / 2;
+                let point = if term < 2 { GENERATOR[index] } else { table[index] };
+                acc += if digit < 0 { -point } else { point };
+            }
+        }
+        acc
+    }
+}
