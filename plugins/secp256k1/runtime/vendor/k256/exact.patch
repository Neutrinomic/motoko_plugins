+fn digits(k: &Scalar, l: &Scalar) -> [[i8; 129]; 4] {
+    let mut result = [[0i8; 129]; 4];
+    for (i, scalar) in [k, l].into_iter().enumerate() {
+        let (a, b) = decompose_scalar(scalar);
+        for (j, component) in [a, b].into_iter().enumerate() {
+            let negative = bool::from(component.is_high());
+            let mut ds = wnaf_128_vartime(&if negative { -component } else { component });
+            if negative { for d in &mut ds { *d = -*d; } }
+            result[i * 2 + j] = ds;
+        }
+    }
+    result
+}
