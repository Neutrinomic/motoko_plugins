func append(a : Blob, b : Blob) : Blob {
  let left = Prim.blobToArray(a);
  let right = Prim.blobToArray(b);
  Prim.arrayToBlob(Prim.Array_tabulate<Nat8>(left.size() + right.size(), func i {
    if (i < left.size()) left[i] else right[i - left.size()]
  }))
};
var digest : Nat64 = 14695981039346656037;
func record(encoded : Blob) {
  for (byte in encoded.values()) {
    digest := (digest ^ Prim.natToNat64(Prim.nat8ToNat(byte))) *% 1099511628211;
  };
  digest := (digest ^ 255) *% 1099511628211;
};
for ((value, golden) in nats.values()) {
  let encoded = ok(Wire.encode(value));
  assert encoded == golden;
  assert ok(Wire.decode<Nat>(golden)) == value;
  assert ok(Wire.encode((0x5a : Nat8, value, 0xa5 : Nat8))) == append("\5a", append(golden, "\a5"));
  assert ok(Wire.encode([value, value])) == append("\02", append(golden, golden));
  record(encoded);
};
for ((value, golden) in ints.values()) {
  let encoded = ok(Wire.encode(value));
  assert encoded == golden;
  assert ok(Wire.decode<Int>(golden)) == value;
  assert ok(Wire.encode((0x5a : Nat8, value, 0xa5 : Nat8))) == append("\5a", append(golden, "\a5"));
  assert ok(Wire.encode([value, value])) == append("\02", append(golden, golden));
  record(encoded);
};
Prim.debugPrint(debug_show (nats.size(), ints.size(), digest));
