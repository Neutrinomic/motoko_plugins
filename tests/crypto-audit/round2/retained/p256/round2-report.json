  "changes": [
    "Fixed-base secret-scalar comb with fixed 64 iterations and full masked selection across all 15 entries; independently checked table; explicit scalar and byte zeroization.",
    "Public-input-only width-5 nonadjacent form simultaneous ECDSA multiplication, preserving all SEC1, digest, signature and high-S validation and single affine normalization.",
    "Return managed 72-byte DER scratch directly only when exact output length is 72; preserve exact-length copy for shorter encodings.",
    "Reproducible independent table proof, upstream arithmetic differential tests and retained DER72 output/GC Ash regression."
  ],
  "unchanged": [
    "Public P256 module and API",
    "Cargo dependencies and lock",
    "RFC6979 signing algorithm including bits2octets reduction",
    "Portable OCaml semantics and loading independence",
    "Native ABI, typed errors and validation precedence"
  ],
