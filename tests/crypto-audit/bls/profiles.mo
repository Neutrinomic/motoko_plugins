import B "mo:fast/BLS12381";
import P "mo:⛔";
let pk0 : Blob = "\8c\e3\b5\7b\79\17\98\43\3f\d3\23\75\34\89\ca\c9\bc\a4\3b\98\de\aa\fa\ed\91\f4\cb\01\07\30\ae\1e\38\b1\86\cc\d3\7a\09\b8\ae\d6\2c\e2\3b\69\9c\48";
let msg0 : Blob = "\61\75\64\69\74\2d\41";
let sig0 : Blob = "\8a\80\cc\c6\2a\d1\38\69\f4\3a\9c\1b\d7\4c\a5\0e\29\bc\54\4b\f3\ce\2b\33\41\76\77\a4\6a\7b\d9\28\ac\78\3d\8d\54\69\a0\ad\81\d9\fe\1f\c9\62\77\43\02\e3\0d\7f\46\0a\17\77\8f\d6\72\34\d6\11\7c\d6\c4\8f\83\6e\cb\2f\05\7c\76\5d\9e\48\10\32\12\a4\93\f5\0f\c0\79\36\77\46\ae\cd\77\6e\38\74\48\95";
let pop0 : Blob = "\96\9a\1f\7e\52\0b\cd\7e\3d\a7\91\bb\78\83\83\06\2d\30\c8\b0\f2\b3\eb\d6\70\0e\04\1e\1b\a1\e9\83\bb\d5\e3\10\38\0f\6c\5b\a2\5d\a8\1c\91\64\87\f9\19\2b\c3\3c\0c\95\78\1d\d4\b2\31\6b\bd\9a\9e\a3\4a\20\ff\ac\32\9c\f6\17\f6\68\f8\47\f4\07\19\4f\db\b4\77\7e\a2\b9\35\7b\d9\7e\20\69\11\6b\04\a1";
let pk1 : Blob = "\aa\10\e1\05\5b\14\a8\9c\c3\26\16\99\52\49\98\73\2f\dd\c4\f3\0c\76\c1\05\7e\b8\37\32\a0\14\16\64\3e\b0\15\a9\32\e4\08\0c\86\f4\2e\48\59\73\d2\40";
let msg1 : Blob = "\61\75\64\69\74\2d\42";
let pop1 : Blob = "\b5\51\0f\03\10\e3\b9\c9\ba\2d\f8\c6\60\fe\40\9f\db\f5\3a\5e\0a\3a\7f\e8\0e\76\55\13\88\79\13\c8\78\14\09\cf\03\66\da\b9\74\c7\0a\4d\f4\a8\23\e7\05\f7\cd\fc\18\16\9e\d5\9c\16\ff\6e\95\27\3d\a9\d6\6e\ab\ff\cb\45\9d\95\ad\c4\d5\f4\1d\cf\6f\b1\d3\88\38\74\8f\41\4f\66\08\bc\04\23\3b\51\37\29";
let aggregate : Blob = "\a2\ce\9d\d9\96\83\6a\ec\32\24\1d\78\86\4b\e8\fc\f4\bd\5d\52\40\77\be\57\a7\d7\db\b6\ac\d9\3d\a9\36\a3\52\88\82\8c\f6\91\b5\90\c4\3a\95\bb\3a\dd\11\5f\97\00\76\50\fb\d8\10\d5\44\b6\e8\89\ba\6d\1f\52\7d\37\54\bd\f8\c2\f0\58\83\ca\68\a6\a5\08\24\f9\46\66\4c\6e\6f\86\a1\a8\43\57\f1\49\ab\94";
let fast : Blob = "\90\35\cc\f4\b6\53\91\68\e7\26\f5\bb\ea\f7\4a\08\09\69\2c\c6\61\5b\23\4b\39\69\53\aa\7b\9c\6b\b2\84\71\95\a1\11\b7\a9\ba\65\69\42\50\b7\ab\ea\ad\01\7a\62\ff\08\05\4a\4b\ba\be\7a\e5\3e\d7\cb\f2\80\4d\69\fa\0c\56\b8\f8\c4\f3\0b\c2\84\32\81\de\73\f7\07\da\47\58\b1\96\dc\d1\99\fd\2c\33\25\00";
assert B.aggregateVerifyEthereum([pk0,pk1],[pop0,pop1],[msg0,msg1],aggregate) == #ok(true);
assert B.aggregateVerifyEthereum([pk0,pk1],[pop0,pop1],[msg1,msg0],aggregate) == #ok(false);
assert B.aggregateVerifyEthereum([pk0,pk1],[pop1,pop0],[msg0,msg1],aggregate) == #err(#invalidProof);
assert B.aggregateVerifyEthereum([pk0,pk1],[pop0,pop1],[msg0,msg0],fast) == #ok(true);
assert B.fastAggregateVerifyEthereum([pk0,pk1],[pop0,pop1],msg0,fast) == #ok(true);
assert B.fastAggregateVerifyEthereum([pk0,pk1],[pop0,pop1],msg1,fast) == #ok(false);
assert B.aggregateVerifyEthereum([pk0],[],[msg0],sig0) == #err(#invalidLength);
assert B.aggregateVerifyEthereum([pk0],[pop0],[],sig0) == #err(#invalidLength);
assert B.aggregateVerifyEthereum([],[],[],B.g2Identity) == #err(#emptyBatch);
assert B.fastAggregateVerifyEthereum([],[],msg0,B.g2Identity) == #err(#emptyBatch);
assert B.aggregateVerifyIC([],[],B.g1Identity) == #err(#emptyBatch);
assert B.aggregateVerifyIC([B.g2Generator,B.g2Generator],[msg0,msg0],B.g1Generator) == #err(#duplicateMessage);
assert B.aggregateVerifyIC([B.g2Generator],[],B.g1Generator) == #err(#invalidLength);
assert B.fastAggregateVerifyEthereum([B.g1Identity],[pop0],msg0,sig0) == #err(#identity);
let rogue : Blob = "\b5\75\20\f5\15\0e\d6\46\e8\c2\6a\01\bf\0b\d1\5a\32\4c\c6\6f\a8\90\3f\33\fa\26\c3\b4\dd\16\b9\a7\c5\11\8f\da\c9\ee\3e\ce\ba\5f\f2\13\8c\dc\e8\f0";
let forged : Blob = "\b3\02\f9\2f\f7\8f\cb\25\ea\52\2c\24\5f\08\fd\5b\00\9d\e3\1b\08\06\8e\40\e2\dc\00\9a\99\83\0e\df\8e\b5\bf\df\ed\85\4c\76\4b\fe\10\03\ae\0d\9f\d3\17\1f\b4\3d\46\21\e3\69\99\34\ab\ba\a6\71\ab\9b\3a\c3\da\0a\15\df\3e\aa\b4\98\85\c2\6a\d7\46\31\cd\a4\32\ff\0f\07\9e\eb\b1\02\4a\28\5f\c7\3f\b6";
assert B.fastAggregateVerifyEthereum([pk0,rogue],[pop0,pop1],msg0,forged) == #err(#invalidProof);
let ic0 : Blob = "\ac\7f\a6\3d\fc\38\bb\f3\71\2e\27\a1\80\39\1b\ca\4c\ca\bf\60\9c\59\67\a0\59\2e\ff\42\0b\62\35\f3\f2\b3\23\05\1c\b0\99\ac\c3\96\9a\ca\31\0f\7f\f4\19\1b\2d\6d\b4\3f\af\c2\c9\59\2f\7e\5f\73\98\11\07\97\5d\3d\92\b8\43\89\1e\72\4d\bc\9f\05\b5\ee\e5\a3\b2\b1\fc\78\2e\de\81\49\f3\08\30\b8\44\44";
let ic1 : Blob = "\81\a8\f4\e5\91\ca\53\07\7b\38\90\e0\54\a0\35\47\4a\69\28\4a\de\73\85\d0\de\62\4b\10\3d\f7\90\09\58\d6\04\aa\5d\78\c6\f4\5b\c0\a1\90\d3\09\50\47\09\43\49\38\b1\be\e7\25\2a\86\62\11\25\69\ed\ab\b4\f9\8e\29\a8\9c\7b\2c\07\2b\07\aa\19\08\80\bf\dc\31\34\e7\d1\95\7f\0c\cf\99\b2\86\85\6b\cd\c7";
let icAggregate : Blob = "\ac\46\ad\57\4a\71\fc\6e\94\1e\34\13\8f\a9\0b\b2\d0\38\3b\27\3c\9d\14\f0\ee\71\a4\c5\ba\1f\a9\f4\01\dd\5e\33\a7\b0\55\c5\56\40\2a\33\87\39\3a\00";
assert B.aggregateVerifyIC([ic0,ic1],[msg0,msg1],icAggregate) == #ok(true);
assert B.aggregateVerifyIC([ic0,ic1],[msg1,msg0],icAggregate) == #ok(false);
assert B.aggregateVerifyIC([ic0,ic1],[msg0,msg0],icAggregate) == #err(#duplicateMessage);
let tooMany = P.Array_init<Blob>(129, pk0);
let tooManyFrozen = P.Array_tabulate<Blob>(129, func(i) { tooMany[i] });
assert B.fastAggregateVerifyEthereum(tooManyFrozen,tooManyFrozen,msg0,sig0) == #err(#tooManyItems);
assert B.aggregateVerifyEthereum(tooManyFrozen,tooManyFrozen,tooManyFrozen,sig0) == #err(#tooManyItems);
assert B.aggregateVerifyIC(tooManyFrozen,tooManyFrozen,B.g1Generator) == #err(#tooManyItems);
var evaluated = 0;
func once(p : Blob) : Blob { evaluated += 1; p };
assert B.g1Add(once(B.g1Generator),once(B.g1Identity)) == #ok(B.g1Generator);
assert evaluated == 2;
let validationAlias = B.validateG1;
assert validationAlias(B.g1Generator) == #ok(B.g1Generator);
P.debugPrint("independent BLS profile audit passed");
