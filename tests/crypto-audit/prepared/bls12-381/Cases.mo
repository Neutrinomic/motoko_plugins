  public func checkRetained(k : {ic : [B.PreparedICPublicKey]; eth : [B.PreparedEthereumPublicKey]; pop : [B.PreparedEthereumPoPKey]}) {
    assert B.verifyICPrepared(k.ic[0],b16,b10) == #ok(true);
    assert B.verifyEthereumPrepared(k.eth[0],b16,b13) == #ok(true);
    assert B.aggregateVerifyEthereumPrepared([k.pop[0]],[b16],b13) == #ok(true);
    assert B.verifyICPrepared(k.ic[1],b17,b11) == #ok(true);
    assert B.verifyEthereumPrepared(k.eth[1],b17,b14) == #ok(true);
    assert B.aggregateVerifyEthereumPrepared([k.pop[1]],[b17],b14) == #ok(true);
  };
