  public type Keys = {ic : [B.PreparedICPublicKey]; eth : [B.PreparedEthereumPublicKey]; pop : [B.PreparedEthereumPoPKey]};
  public func keys() : Keys {
    {
      ic = [ok(B.prepareICPublicKey(b1)),ok(B.prepareICPublicKey(b2)),ok(B.prepareICPublicKey(b3))];
      eth = [ok(B.prepareEthereumPublicKey(b4)),ok(B.prepareEthereumPublicKey(b5)),ok(B.prepareEthereumPublicKey(b6))];
      pop = [ok(B.prepareEthereumPoPKey(b4,b7)),ok(B.prepareEthereumPoPKey(b5,b8)),ok(B.prepareEthereumPoPKey(b6,b9))];
    }
  };
  public func singles() { let k=keys();
    // ic-valid-0
    assert B.verifyICPrepared(k.ic[0],b16,b10) == #ok(true); assert B.verifyICPrepared(k.ic[0],b16,b10) == B.verifyIC(b1,b16,b10);
    // ic-wrong-key-0
    assert B.verifyICPrepared(k.ic[1],b16,b10) == #ok(false); assert B.verifyICPrepared(k.ic[1],b16,b10) == B.verifyIC(b2,b16,b10);
    // ic-wrong-message-0
    assert B.verifyICPrepared(k.ic[0],b34,b10) == #ok(false); assert B.verifyICPrepared(k.ic[0],b34,b10) == B.verifyIC(b1,b34,b10);
    // ic-valid-1
    assert B.verifyICPrepared(k.ic[1],b17,b11) == #ok(true); assert B.verifyICPrepared(k.ic[1],b17,b11) == B.verifyIC(b2,b17,b11);
    // ic-wrong-key-1
    assert B.verifyICPrepared(k.ic[0],b17,b11) == #ok(false); assert B.verifyICPrepared(k.ic[0],b17,b11) == B.verifyIC(b1,b17,b11);
    // ic-wrong-message-1
    assert B.verifyICPrepared(k.ic[1],b34,b11) == #ok(false); assert B.verifyICPrepared(k.ic[1],b34,b11) == B.verifyIC(b2,b34,b11);
    // ic-signature-empty
    assert B.verifyICPrepared(k.ic[0],b16,b0) == #err(#invalidLength); assert B.verifyICPrepared(k.ic[0],b16,b0) == B.verifyIC(b1,b16,b0);
    // ic-signature-short
    assert B.verifyICPrepared(k.ic[0],b16,b26) == #err(#invalidLength); assert B.verifyICPrepared(k.ic[0],b16,b26) == B.verifyIC(b1,b16,b26);
    // ic-signature-long
    assert B.verifyICPrepared(k.ic[0],b16,b27) == #err(#invalidLength); assert B.verifyICPrepared(k.ic[0],b16,b27) == B.verifyIC(b1,b16,b27);
    // ic-signature-flags
    assert B.verifyICPrepared(k.ic[0],b16,b28) == #err(#invalidPoint); assert B.verifyICPrepared(k.ic[0],b16,b28) == B.verifyIC(b1,b16,b28);
    // ic-signature-infinity-sign
    assert B.verifyICPrepared(k.ic[0],b16,b29) == #err(#invalidPoint); assert B.verifyICPrepared(k.ic[0],b16,b29) == B.verifyIC(b1,b16,b29);
    // ic-signature-infinity-coordinate
    assert B.verifyICPrepared(k.ic[0],b16,b30) == #err(#invalidPoint); assert B.verifyICPrepared(k.ic[0],b16,b30) == B.verifyIC(b1,b16,b30);
    // ic-signature-field-modulus
    assert B.verifyICPrepared(k.ic[0],b16,b31) == #err(#invalidPoint); assert B.verifyICPrepared(k.ic[0],b16,b31) == B.verifyIC(b1,b16,b31);
    // ic-signature-subgroup
    assert B.verifyICPrepared(k.ic[0],b16,b32) == #err(#invalidPoint); assert B.verifyICPrepared(k.ic[0],b16,b32) == B.verifyIC(b1,b16,b32);
    // ic-signature-identity
    assert B.verifyICPrepared(k.ic[0],b16,b33) == #err(#identity); assert B.verifyICPrepared(k.ic[0],b16,b33) == B.verifyIC(b1,b16,b33);
    // ic-negative-key-valid
    assert B.verifyICPrepared(k.ic[2],b16,b12) == #ok(true); assert B.verifyICPrepared(k.ic[2],b16,b12) == B.verifyIC(b3,b16,b12);
    // eth-valid-0
    assert B.verifyEthereumPrepared(k.eth[0],b16,b13) == #ok(true); assert B.verifyEthereumPrepared(k.eth[0],b16,b13) == B.verifyEthereum(b4,b16,b13);
    // eth-wrong-key-0
    assert B.verifyEthereumPrepared(k.eth[1],b16,b13) == #ok(false); assert B.verifyEthereumPrepared(k.eth[1],b16,b13) == B.verifyEthereum(b5,b16,b13);
    // eth-wrong-message-0
    assert B.verifyEthereumPrepared(k.eth[0],b34,b13) == #ok(false); assert B.verifyEthereumPrepared(k.eth[0],b34,b13) == B.verifyEthereum(b4,b34,b13);
    // eth-valid-1
    assert B.verifyEthereumPrepared(k.eth[1],b17,b14) == #ok(true); assert B.verifyEthereumPrepared(k.eth[1],b17,b14) == B.verifyEthereum(b5,b17,b14);
    // eth-wrong-key-1
    assert B.verifyEthereumPrepared(k.eth[0],b17,b14) == #ok(false); assert B.verifyEthereumPrepared(k.eth[0],b17,b14) == B.verifyEthereum(b4,b17,b14);
    // eth-wrong-message-1
    assert B.verifyEthereumPrepared(k.eth[1],b34,b14) == #ok(false); assert B.verifyEthereumPrepared(k.eth[1],b34,b14) == B.verifyEthereum(b5,b34,b14);
    // eth-signature-empty
    assert B.verifyEthereumPrepared(k.eth[0],b16,b0) == #err(#invalidLength); assert B.verifyEthereumPrepared(k.eth[0],b16,b0) == B.verifyEthereum(b4,b16,b0);
    // eth-signature-short
    assert B.verifyEthereumPrepared(k.eth[0],b16,b18) == #err(#invalidLength); assert B.verifyEthereumPrepared(k.eth[0],b16,b18) == B.verifyEthereum(b4,b16,b18);
    // eth-signature-long
    assert B.verifyEthereumPrepared(k.eth[0],b16,b19) == #err(#invalidLength); assert B.verifyEthereumPrepared(k.eth[0],b16,b19) == B.verifyEthereum(b4,b16,b19);
    // eth-signature-flags
    assert B.verifyEthereumPrepared(k.eth[0],b16,b20) == #err(#invalidPoint); assert B.verifyEthereumPrepared(k.eth[0],b16,b20) == B.verifyEthereum(b4,b16,b20);
    // eth-signature-infinity-sign
    assert B.verifyEthereumPrepared(k.eth[0],b16,b21) == #err(#invalidPoint); assert B.verifyEthereumPrepared(k.eth[0],b16,b21) == B.verifyEthereum(b4,b16,b21);
    // eth-signature-infinity-coordinate
    assert B.verifyEthereumPrepared(k.eth[0],b16,b22) == #err(#invalidPoint); assert B.verifyEthereumPrepared(k.eth[0],b16,b22) == B.verifyEthereum(b4,b16,b22);
    // eth-signature-field-modulus
    assert B.verifyEthereumPrepared(k.eth[0],b16,b23) == #err(#invalidPoint); assert B.verifyEthereumPrepared(k.eth[0],b16,b23) == B.verifyEthereum(b4,b16,b23);
    // eth-signature-subgroup
    assert B.verifyEthereumPrepared(k.eth[0],b16,b24) == #err(#invalidPoint); assert B.verifyEthereumPrepared(k.eth[0],b16,b24) == B.verifyEthereum(b4,b16,b24);
    // eth-signature-identity
    assert B.verifyEthereumPrepared(k.eth[0],b16,b25) == #err(#identity); assert B.verifyEthereumPrepared(k.eth[0],b16,b25) == B.verifyEthereum(b4,b16,b25);
    // eth-negative-key-valid
    assert B.verifyEthereumPrepared(k.eth[2],b16,b15) == #ok(true); assert B.verifyEthereumPrepared(k.eth[2],b16,b15) == B.verifyEthereum(b6,b16,b15);
  };
  public func aggregates() { aggregatePart(0); aggregatePart(1); aggregatePart(2) };
  public func aggregatePart(part : Nat) { let k=keys();
    // ic-valid
    if (part == 0) { let result = B.aggregateVerifyICPrepared([k.ic[0],k.ic[1]],[b16,b17],b35); assert result == #ok(true); assert result == B.aggregateVerifyIC([b1,b2],[b16,b17],b35) };
    // ic-wrong-message
    if (part == 0) { let result = B.aggregateVerifyICPrepared([k.ic[0],k.ic[1]],[b16,b36],b35); assert result == #ok(false); assert result == B.aggregateVerifyIC([b1,b2],[b16,b36],b35) };
    // ic-wrong-key
    if (part == 0) { let result = B.aggregateVerifyICPrepared([k.ic[1],k.ic[0]],[b16,b17],b35); assert result == #ok(false); assert result == B.aggregateVerifyIC([b2,b1],[b16,b17],b35) };
    // ic-signature-empty
    if (part == 0) { let result = B.aggregateVerifyICPrepared([k.ic[0],k.ic[1]],[b16,b17],b0); assert result == #err(#invalidLength); assert result == B.aggregateVerifyIC([b1,b2],[b16,b17],b0) };
    // ic-signature-short
    if (part == 0) { let result = B.aggregateVerifyICPrepared([k.ic[0],k.ic[1]],[b16,b17],b26); assert result == #err(#invalidLength); assert result == B.aggregateVerifyIC([b1,b2],[b16,b17],b26) };
    // ic-signature-long
    if (part == 0) { let result = B.aggregateVerifyICPrepared([k.ic[0],k.ic[1]],[b16,b17],b27); assert result == #err(#invalidLength); assert result == B.aggregateVerifyIC([b1,b2],[b16,b17],b27) };
    // ic-signature-flags
    if (part == 0) { let result = B.aggregateVerifyICPrepared([k.ic[0],k.ic[1]],[b16,b17],b28); assert result == #err(#invalidPoint); assert result == B.aggregateVerifyIC([b1,b2],[b16,b17],b28) };
    // ic-signature-infinity-sign
    if (part == 0) { let result = B.aggregateVerifyICPrepared([k.ic[0],k.ic[1]],[b16,b17],b29); assert result == #err(#invalidPoint); assert result == B.aggregateVerifyIC([b1,b2],[b16,b17],b29) };
    // ic-signature-infinity-coordinate
    if (part == 0) { let result = B.aggregateVerifyICPrepared([k.ic[0],k.ic[1]],[b16,b17],b30); assert result == #err(#invalidPoint); assert result == B.aggregateVerifyIC([b1,b2],[b16,b17],b30) };
    // ic-signature-field-modulus
